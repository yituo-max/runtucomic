{
  "images": {
    "sizes": [300, 400, 640, 750, 828, 1080, 1200],
    "domains": ["i.ibb.co"],
    "minimumCacheTTL": 86400,
    "formats": ["image/avif", "image/webp"]
  },
  "functions": {
    "api/index.js": {
      "includeFiles": "comic-data/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ]
}
